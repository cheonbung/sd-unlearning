models/core/fcf/upstream/

# Downloaded COCO eval data (regenerated by eval_coco.py)
eval/data/coco/

# --- Exceptions: small, license-clean files needed for self-contained reproduction ---
# Q16 learned prompts (~3 KB, MIT-licensed, ml-research/Q16) used by violence/Q16 eval.
!**/q16_weights/
!**/q16_weights/prompts.p

# Google Drive sync temp files (transient, break git add)
.tmp.driveupload/

# Official FCF reproduction checkpoints (weights are *.pt/gitignored; the saved HF dir's
# tokenizer.json/config.json are standard CLIP + regenerable -> not committed)
models/core/fcf/official_fcf_p/
models/core/fcf/official_fcf_e/
# FCF-repro runtime state sentinels (regenerated each run)
models/core/fcf/PIPELINE_STATUS
